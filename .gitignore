# Vendor bundles too large for git
scripts/tesseract-core/
semantic/transformers.min.js
semantic/benefit-embeddings.json


# ── Deployment excludes ──────────────────────────────────────────
# Wrangler respects .gitignore when running `wrangler pages deploy`
# None of these should ever be served from Cloudflare Pages.

# Electron desktop app — not a web asset
electron-app/

# ATIP documents and processing scripts — sensitive, not web content
atip/

# Local AI assistant config — never public
.claude/
.env

# Node artifacts (if electron-app deps ever get installed locally)
node_modules/

# ── Neon Circuit Room Authority (Phase 1b+) ─────────────────────
# Wrangler local dev state for the authority Worker + DO
# Root wrangler cache (account/pages id cache) — local-only, never tracked.
.wrangler/
workers/arcade/.wrangler/
workers/arcade/node_modules/
workers/arcade/.env
workers/arcade/.dev.vars
# Wrangler build output (`wrangler deploy --dry-run --outdir dist`) — regenerated, never committed
workers/arcade/dist/
workers/insights/.wrangler/
workers/insights/node_modules/
workers/insights/dist/
workers/insights/.dev.vars

# Local DO SQLite storage (when running with --local)
*.sqlite
*.sqlite-shm
*.sqlite-wal
# Arcade Studio (Vite+Three.js creator tool) build output
arcade-studio/dist/
arcade-studio/node_modules/

# ── Untracked sibling projects / local experiments ──────────────
# Separate projects that live inside this worktree but are NOT part of the
# CloveLearn deploy surface. Ignored so a `git add -A` can never sweep them
# into a commit (and thence into the curated upload). See TRUST_STACK_FINAL_STATUS.
prototype/
artifacts/
webbroswer assest creator/

# Local foundry coordination state (tailnet addresses, agent message logs) — never commit.
.foundry/

# Rust build artifacts
target/

# Generated build/runtime artifacts
__pycache__/
*.py[cod]
*.egg-info/
