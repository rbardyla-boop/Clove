{
  "name": "clove-research",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "LIVE_SOURCES=1 vitest run test/live-source.test.ts",
    "test:live-discovery": "LIVE_SOURCES=1 vitest run test/live-discovery.test.ts",
    "test:live-evidence": "LIVE_SOURCES=1 vitest run test/live-evidence.test.ts",
    "types": "wrangler types",
    "dry-run": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
