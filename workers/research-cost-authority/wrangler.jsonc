{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clove-research-cost-authority",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "internal-only"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COST_AUTHORITY",
        "class_name": "CostAuthority"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CostAuthority"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.01
    }
  }
}
