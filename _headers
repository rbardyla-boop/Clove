## ═══════════════════════════════════════════════════════════════
## CloveLearn.io — Cloudflare Pages Edge Headers
## Zero-cloud constitution compliant. No tracking. No cookies.
## ═══════════════════════════════════════════════════════════════

## ── GLOBAL: ALL PAGES ─────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://i.scdn.co; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net https://static.cloudflareinsights.com; connect-src 'self' https://open.spotify.com https://accounts.spotify.com https://api.spotify.com https://huggingface.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.hf.co https://xethub.hf.co https://cas-bridge.xethub.hf.co https://cdn.jsdelivr.net blob:; worker-src 'self' blob: https://cdn.jsdelivr.net; media-src 'self' blob:
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

## ── INTELLIGENCE OPS: COEP OVERRIDE ──────────────────────────
## transformers.js WASM backend creates blob: URLs for its worker
## and then dynamically imports them. COEP: credentialless causes
## Chrome to treat blob: URLs as null-origin in isolated contexts,
## killing the import. Override to unsafe-none for this page only.
## COOP stays intact (same-origin) — only COEP is relaxed.
/intelligence-ops.html
  Cross-Origin-Embedder-Policy: unsafe-none

## ── STATIC ASSETS: LONG CACHE ─────────────────────────────────
## Icons, JS, manifest — cache aggressively (1 year)
## SW version bump forces cache invalidation anyway
/particle-bg.js
  Cache-Control: public, max-age=31536000, immutable

/od-core.js
  Cache-Control: public, max-age=31536000, immutable

/voice-engine.js
  Cache-Control: public, max-age=31536000, immutable

/stt-worker.js
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

## ── SERVICE WORKER: NO CACHE ──────────────────────────────────
## SW must always be fresh so version bumps propagate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

## ── HTML PAGES: SHORT CACHE ───────────────────────────────────
## Users should get fresh content on deploy
## But allow edge caching for speed
/*.html
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400

/
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400
