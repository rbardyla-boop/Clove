## ═══════════════════════════════════════════════════════════════
## CloveLearn.io — Cloudflare Pages Edge Headers
## Privacy-first static client. No cookies or user-authored mission text in telemetry.
## ═══════════════════════════════════════════════════════════════

## ── GLOBAL: ALL PAGES ─────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://i.scdn.co; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net; connect-src 'self' https://open.spotify.com https://accounts.spotify.com https://api.spotify.com https://huggingface.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.hf.co https://xethub.hf.co https://cas-bridge.xethub.hf.co https://cdn.jsdelivr.net blob: ws://localhost:8787 wss://clovelearn.io wss://*.workers.dev; worker-src 'self' blob:; media-src 'self' blob:; form-action 'self'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

## ── GAME: CDN SCRIPTS ALLOWED ─────────────────────────────────
/game/*
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net https://static.cloudflareinsights.com; connect-src 'self' https://cdn.jsdelivr.net blob:; worker-src 'self' blob:; media-src 'self' blob:; manifest-src data: blob:; form-action 'self'

## ── INTELLIGENCE OPS: COEP OVERRIDE ──────────────────────────
/intelligence-ops.html
  Cross-Origin-Embedder-Policy: unsafe-none

## ── STATIC ASSETS: LONG CACHE ─────────────────────────────────
/particle-bg.js
  Cache-Control: public, max-age=31536000, immutable

/od-core.js
  Cache-Control: public, max-age=31536000, immutable

/voice-engine.js
  Cache-Control: public, max-age=31536000, immutable

/stt-worker.js
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

## ── SERVICE WORKER: ALWAYS REVALIDATE ─────────────────────────
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/clove-signals.js
  Cache-Control: public, max-age=300, must-revalidate

/home.js
  Cache-Control: public, max-age=300, must-revalidate

/hub.css
  Cache-Control: public, max-age=3600, must-revalidate

## ── HTML PAGES: LEGACY SHORT CACHE ────────────────────────────
/*.html
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400

/
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400

## ── MISSION 001 PILOT: DO NOT SERVE A STALE BUILD ─────────────
## These narrower rules detach the broader legacy Cache-Control rule first.
/mission-001.html
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/mission-001-app.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/mission-private-store.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate
